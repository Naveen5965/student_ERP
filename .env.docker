# Docker Environment Variables
# Copy this file to .env and update the values

# Application
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://mongo:27017/student_erp
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MONGO_PORT=27017

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
REFRESH_TOKEN_SECRET=your-refresh-token-secret-also-min-32-chars

# Email (Outlook/Office365)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=your-email@outlook.com
EMAIL_PASS=your-email-password

# SMS - Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SMS - MSG91 (Alternative)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=STERP

# Payment Gateway - Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Payment Gateway - PhonePe
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX=1

# Development Tools
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin123
REDIS_COMMANDER_PORT=8082
