{
  "name": "student-erp-testing",
  "version": "1.0.0",
  "description": "Test suite for Student ERP System",
  "scripts": {
    "test": "npm run test:all",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:api && npm run test:frontend && npm run test:security && npm run test:performance",
    "test:unit": "jest --config=jest.unit.config.js",
    "test:integration": "jest --config=jest.integration.config.js",
    "test:api": "jest --config=jest.api.config.js",
    "test:frontend": "jest --config=jest.frontend.config.js",
    "test:security": "jest --config=jest.security.config.js",
    "test:performance": "jest --config=jest.performance.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:test:setup": "node scripts/setup-test-db.js",
    "db:test:seed": "node scripts/seed-test-data.js",
    "db:test:clean": "node scripts/clean-test-db.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "security:audit": "npm audit",
    "security:scan": "node scripts/security-scan.js",
    "performance:test": "node scripts/performance-test.js",
    "coverage:report": "jest --coverage && open coverage/lcov-report/index.html"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@testing-library/dom": "^9.3.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "babel-jest": "^29.5.0",
    "eslint": "^8.43.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-environment-node": "^29.5.0",
    "prettier": "^2.8.8",
    "puppeteer": "^20.7.0",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^8.13.0"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.1",
    "mongoose": "^7.3.0",
    "multer": "^1.4.5-lts.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/testing/setup.js"],
    "testMatch": [
      "<rootDir>/testing/**/*.test.js",
      "<rootDir>/testing/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "backend/**/*.js",
      "!backend/node_modules/**",
      "!backend/coverage/**",
      "!backend/dist/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}